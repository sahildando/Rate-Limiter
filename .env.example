# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# Database (local Docker Compose uses postgres service hostname)
DATABASE_URL=postgresql+asyncpg://monitoring:monitoring@postgres:5432/monitoring

# Redis (local Docker Compose uses redis service hostname)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS / frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Celery / Scheduler
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SCHEDULER_POLL_INTERVAL_SECONDS=5
SCHEDULER_BATCH_SIZE=100
MONITOR_LOCK_TTL_SECONDS=120
MONITOR_PENDING_TTL_SECONDS=120

# Retry / failure detection
MONITOR_RETRY_MAX_ATTEMPTS=3
MONITOR_RETRY_BASE_DELAY_SECONDS=1.0
MONITOR_RETRY_MAX_DELAY_SECONDS=30.0
MONITOR_FAILURE_THRESHOLD=3

# Rate limiting / idempotency
RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5
IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Production (Render + Neon + Upstash + Vercel) — set in platform dashboards only
# -----------------------------------------------------------------------------
# ENVIRONMENT=production
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
# REDIS_URL=rediss://:<password>@<upstash-host>:6379
# CELERY_BROKER_URL=rediss://:<password>@<upstash-host>:6379
# CELERY_RESULT_BACKEND=rediss://:<password>@<upstash-host>:6379
# JWT_SECRET=<generate-32+-char-secret>
# CORS_ORIGINS=https://<your-app>.vercel.app
# FRONTEND_URL=https://<your-app>.vercel.app
# NEXT_PUBLIC_API_URL=https://<your-api>.onrender.com
